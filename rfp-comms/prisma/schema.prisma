generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Schema pushes need a direct (non-pooled) connection; the Neon integration
  // on Vercel injects this automatically alongside DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Client {
  id         String    @id @default(cuid())
  name       String
  engagement String    @default("")
  notes      String    @default("")
  status     String    @default("SETUP") // SETUP | IN_PROGRESS | COMPLETE
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  audiences  Audience[]
  contacts   Contact[]
  sendLogs   SendLog[]
}

model Audience {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key            String // "A" | "B"
  label          String
  targetSendDate String    @default("") // YYYY-MM-DD, date-only to avoid TZ drift
  bccEmails      String    @default("") // comma-separated, optional record-keeping BCC
  template       Template?
  contacts       Contact[]
  sendLogs       SendLog[]

  @@unique([clientId, key])
}

model Contact {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  audienceId    String?
  audience      Audience? @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  company       String    @default("")
  firstName     String    @default("")
  lastName      String    @default("")
  email         String
  title         String    @default("")
  category      String    @default("")
  notes         String    @default("")
  emailValid    Boolean   @default(true)
  // Set when this record was explicitly duplicated from another contact so one
  // supplier can receive both communications. Duplicates are ignored by
  // re-import matching (the primary record wins).
  duplicateOfId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sendLogs      SendLog[]
  attachments   ContactAttachment[]

  @@index([clientId, email])
  @@index([audienceId])
}

// Vendor-specific files attached to one supplier contact. Any email sent to
// this contact carries these in addition to the audience template's shared
// attachments. Payloads live in Vercel Blob like template attachments.
model ContactAttachment {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  blobUrl   String
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Template {
  id                    String       @id @default(cuid())
  audienceId            String       @unique
  audience              Audience     @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  subject               String       @default("")
  bodyHtml              String       @default("")
  version               Int          @default(1)
  noAttachmentConfirmed Boolean      @default(false)
  updatedAt             DateTime     @updatedAt
  attachments           Attachment[]
}

model Attachment {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  // Payload lives in Vercel Blob; Postgres keeps only metadata. The URL has
  // an unguessable suffix and never leaves the server — downloads go through
  // the authenticated /api/attachments/[id] proxy.
  blobUrl    String
  createdAt  DateTime @default(now())
}

model SendLog {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  audienceId      String?
  audience        Audience? @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  toEmail         String
  contactName     String   @default("")
  audienceLabel   String   @default("")
  subject         String   @default("")
  templateVersion Int      @default(1)
  // PENDING = row claimed before the Graph call; SENT/FAILED = final outcome.
  // A row stuck in PENDING means the function died mid-send: the email may or
  // may not have gone out, so nothing auto-resends it.
  status          String // PENDING | SENT | FAILED
  isTest          Boolean  @default(false)
  error           String   @default("")
  // Client-generated key, unique per send attempt. Replaying a request with a
  // key we already processed returns the recorded outcome instead of sending
  // again, so lost responses / retries can never double-send.
  idempotencyKey  String?  @unique
  sentAt          DateTime @default(now())

  @@index([clientId, sentAt])
  @@index([contactId, status])
  @@index([audienceId, status])
  @@index([toEmail])
}
